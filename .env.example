# ============================================
# CORE — required for the live site
# ============================================

# Gemini API Key for "Ask Beau" AI chatbot
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Resend API Key for the contact form (visitor → your inbox)
# Get your key at: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# Admin > Data Streams > Web at https://analytics.google.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=your_ga_measurement_id_here

# ============================================
# SUPABASE — required for chat logging, rate limiting,
# and the Global Conflict module
# ============================================
# Single user-managed project. DO NOT use the Vercel Marketplace
# Supabase integration — it provisions a separate ghost project and
# silently overwrites these env vars to point at it.
#
# Resolution priority in src/lib/supabase.ts:
#   BEAU_SUPABASE_*  →  SUPABASE_*  (Marketplace native)  →  NEXT_PUBLIC_SUPABASE_*  (legacy)

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_jwt_or_sb_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_jwt_or_sb_secret_key

# ============================================
# SECURITY
# ============================================

# HMAC secret for the Pi easter egg challenge tokens
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PI_CHALLENGE_SECRET=your_32_byte_hex_secret

# Salt for hashing visitor IPs in chat_conversations + rate_limits tables
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHAT_IP_SALT=your_32_byte_hex_salt

# Bearer token gating /api/conflict/status
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your_32_byte_hex_secret
