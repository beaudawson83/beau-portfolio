# ============================================
# PUBLIC SITE (required for core features)
# ============================================

# Gemini API Key for "Ask Beau" AI chatbot
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Resend API Key for contact form emails
# Get your key at: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Google Analytics 4 Measurement ID (optional)
# Get your ID at: https://analytics.google.com (Admin > Data Streams > Web)
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=your_ga_measurement_id_here

# ============================================
# SYSTEM_LOGS Blog — Admin Auth
# ============================================

# Password you'll type into the login screen
ADMIN_PASSWORD=pick_a_long_random_passphrase

# Random string NextAuth uses to sign session cookies
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_generated_secret

# Production URL (no trailing slash)
NEXTAUTH_URL=https://www.beaudawson.com

# ============================================
# SYSTEM_LOGS Blog — Storage (Contentful CMS)
# ============================================

# Sign up at https://www.contentful.com (free tier is fine)
# Keys live at: Settings > API keys
CONTENTFUL_SPACE_ID=your_space_id
CONTENTFUL_ACCESS_TOKEN=your_delivery_token
CONTENTFUL_PREVIEW_TOKEN=your_preview_token
CONTENTFUL_MANAGEMENT_TOKEN=your_personal_access_token

# ============================================
# OPTIONAL: Supabase (newsletter + view analytics)
# ============================================
# Leave blank to disable newsletter signups and post view tracking.
# Add later at: https://supabase.com/dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
