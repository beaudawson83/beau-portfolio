# ============================================
# CORE — required for the live site
# ============================================

# Gemini API Key for "Ask Beau" AI chatbot
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Brevo API key for ALL transactional email (contact form + UpDraft magic
# links). Replaced Resend on 2026-05-04 — Resend's free tier sandboxed the
# from-address to onboarding@resend.dev which only delivers to the account
# owner's inbox; magic-link auth couldn't reach any other user. Brevo's
# free tier (300 sends/day) supports domain verification with no upgrade.
# Get your key at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here

# The from-address for transactional email. Format options:
#   "UpDraft <noreply@mail.beaudawson.com>"   ← name + email
#   "noreply@mail.beaudawson.com"             ← email only
# Required: the email's domain must be verified on Brevo (one-time DNS work)
# or sends will fail. Each route can override the visible "name" via
# fromName argument; the email portion is fixed by this env var.
MAIL_FROM_ADDRESS="UpDraft <noreply@mail.beaudawson.com>"

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# Admin > Data Streams > Web at https://analytics.google.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=your_ga_measurement_id_here

# ============================================
# SUPABASE — required for chat logging, rate limiting,
# and the Global Conflict module
# ============================================
# Single user-managed project. DO NOT use the Vercel Marketplace
# Supabase integration — it provisions a separate ghost project and
# silently overwrites these env vars to point at it.
#
# Resolution priority in src/lib/supabase.ts:
#   BEAU_SUPABASE_*  →  SUPABASE_*  (Marketplace native)  →  NEXT_PUBLIC_SUPABASE_*  (legacy)

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_jwt_or_sb_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_jwt_or_sb_secret_key

# ============================================
# SECURITY
# ============================================

# HMAC secret for the Pi easter egg challenge tokens
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PI_CHALLENGE_SECRET=your_32_byte_hex_secret

# Salt for hashing visitor IPs in chat_conversations + rate_limits tables
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHAT_IP_SALT=your_32_byte_hex_salt

# Bearer token gating /api/conflict/status
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your_32_byte_hex_secret

# ============================================
# UpDraft (v0.1 — IN PROGRESS)
# Spec lives in skills/updraft/. See PLAN.md §9 for the full env-var
# table and which version each becomes load-bearing.
# ============================================

# HMAC secret for signing the magic-link 32-byte tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UPDRAFT_MAGIC_LINK_SECRET=your_32_byte_hex_secret

# HMAC secret for signing the session cookie payload {uid, exp}.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UPDRAFT_SESSION_COOKIE_SECRET=your_32_byte_hex_secret

# Owner bypass for cost guardrails. Send as Authorization: Bearer <secret>;
# owner sessions skip all caps and tag events `owner: true` for clean
# analytics. Mirrors the BLOG_EDITOR_SECRET pattern. Used during testing
# so Beau's own runs don't burn the daily quota meant for real visitors.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UPDRAFT_OWNER_SECRET=your_32_byte_hex_secret

# Daily caps — env-var configurable so they can be dialed from the Vercel
# dashboard without a redeploy. Defaults below match PLAN.md §5.2.
UPDRAFT_DAILY_SESSION_CAP=50
UPDRAFT_DAILY_TOKEN_CAP_IN=500000
UPDRAFT_DAILY_TOKEN_CAP_OUT=100000
UPDRAFT_PER_IP_DAILY=2
UPDRAFT_SESSION_TOKEN_CAP_IN=200000
UPDRAFT_SESSION_TOKEN_CAP_OUT=50000

# v0.5+ vars. Listed here for completeness; setting them in v0.1 is harmless.
# UPDRAFT_DAILY_PDF_CAP=30
# UPDRAFT_SANDBOX_IMAGE_TAG=updraft-pdf:v0.5.0
